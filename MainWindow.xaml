<Window x:Class="PartsInfo.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PartsInfo"
        mc:Ignorable="d"
        Title="Parts Inventory" Height="720" Width="1180"
        MinHeight="560" MinWidth="900"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI"
        Background="{StaticResource WindowBackgroundBrush}">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="190"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="{StaticResource NavyBrush}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="86"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="18,22,12,14">
                    <Border Width="38" Height="38" CornerRadius="8" Background="#2F6F94">
                        <TextBlock Text="▦" Foreground="White" FontSize="22"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Margin="11,2,0,0">
                        <TextBlock Text="Parts Inventory" Foreground="White" FontWeight="SemiBold" FontSize="14"/>
                        <TextBlock Text="Database manager" Foreground="#AFC4D2" FontSize="11" Margin="0,3,0,0"/>
                    </StackPanel>
                </StackPanel>

                <TextBlock Grid.Row="1" Text="WORKSPACE" Foreground="#9EB7C8"
                           FontSize="10" FontWeight="SemiBold" Margin="22,12,0,8"/>

                <StackPanel Grid.Row="2">
                    <Button x:Name="PartsNavigationButton"
                            Style="{StaticResource NavigationButtonStyle}"
                            Background="#2B526F"
                            Click="PartsNavigationButton_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="▤" FontSize="16" Width="28"/>
                            <TextBlock Text="Parts" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="OrdersNavigationButton"
                            Style="{StaticResource NavigationButtonStyle}"
                            Click="OrdersNavigationButton_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="☷" FontSize="16" Width="28"/>
                            <TextBlock Text="Orders" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="22,0,12,20">
                    <Ellipse Width="8" Height="8" Fill="#69C48D" VerticalAlignment="Center"/>
                    <TextBlock Text="Database connected" Foreground="#B9CFDD" FontSize="11" Margin="8,0,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid x:Name="PartsView" Grid.Column="1" Margin="34,28,34,34">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Parts catalog" Foreground="{StaticResource TextBrush}"
                               FontSize="25" FontWeight="SemiBold"/>
                    <TextBlock Text="Find, review, and maintain part records."
                               Foreground="{StaticResource MutedTextBrush}" FontSize="13" Margin="0,6,0,0"/>
                </StackPanel>
                <Button x:Name="AddPart" Grid.Column="1" Style="{StaticResource PrimaryButtonStyle}"
                        Content="＋  Add part" Click="AddPart_Button_Click" VerticalAlignment="Top"/>
            </Grid>

            <Grid Grid.Row="1" Margin="0,0,0,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="210"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Height="42" Background="{StaticResource SurfaceBrush}"
                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                        CornerRadius="7" Margin="0,0,12,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="38"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="⌕" Foreground="{StaticResource MutedTextBrush}" FontSize="20"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <TextBox x:Name="SearchPartTextBox" Grid.Column="1"
                                 Background="Transparent" BorderThickness="0" Padding="0"
                                 VerticalContentAlignment="Center" FontSize="13"
                                 KeyDown="SearchPartTextBox_KeyDown"/>
                    </Grid>
                </Border>

                <ComboBox x:Name="SearchByMenu" Grid.Column="1"
                          Style="{StaticResource FormComboBoxStyle}" Margin="0,0,12,0">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock VerticalAlignment="Center">
                                <Run Text="Search by: " Foreground="{StaticResource MutedTextBrush}"/>
                                <Run Text="{Binding property}" FontWeight="SemiBold"/>
                            </TextBlock>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>

                <Button x:Name="SearchPartButton" Grid.Column="2"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Content="Search" Click="SearchPartButton_Click"/>
            </Grid>

            <Grid Grid.Row="2" Margin="2,0,2,9">
                <TextBlock Text="Parts" Foreground="{StaticResource TextBrush}" FontWeight="SemiBold" FontSize="13"/>
            </Grid>

            <Border Grid.Row="3" Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8">
                <DataGrid x:Name="PartsDatabase"
                          AutoGenerateColumns="False"
                          Background="Transparent"
                          BorderThickness="0"
                          GridLinesVisibility="Horizontal"
                          HorizontalGridLinesBrush="{StaticResource BorderBrush}"
                          VerticalGridLinesBrush="Transparent"
                          RowBackground="White"
                          AlternatingRowBackground="#FAFCFD"
                          AlternationCount="2"
                          RowHeaderWidth="0"
                          HeadersVisibility="Column"
                          CanUserAddRows="False"
                          CanUserResizeRows="False"
                          IsReadOnly="True"
                          SelectionMode="Single"
                          SelectionUnit="FullRow"
                          FontSize="13">
                    <DataGrid.Resources>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="{StaticResource SurfaceMutedBrush}"/>
                            <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}"/>
                            <Setter Property="FontSize" Value="11"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter Property="Padding" Value="14,11"/>
                            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
                            <Setter Property="BorderThickness" Value="0,0,0,1"/>
                            <Setter Property="HorizontalContentAlignment" Value="Left"/>
                        </Style>
                        <Style TargetType="DataGridCell">
                            <Setter Property="Padding" Value="14,10"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="VerticalContentAlignment" Value="Center"/>
                            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                            <Style.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="#EAF3F8"/>
                                    <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                        <Style TargetType="DataGridRow">
                            <Setter Property="MinHeight" Value="92"/>
                            <Setter Property="BorderThickness" Value="0"/>
                        </Style>
                    </DataGrid.Resources>
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="PART NUMBER" Width="155">
                            <DataGridTemplateColumn.CellStyle>
                                <Style TargetType="DataGridCell" BasedOn="{StaticResource {x:Type DataGridCell}}">
                                    <Setter Property="VerticalContentAlignment" Value="Top"/>
                                </Style>
                            </DataGridTemplateColumn.CellStyle>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="{Binding PartNumber}" Click="PartNumber_Button_Click"
                                            Foreground="{StaticResource ActionBrush}" FontWeight="SemiBold"
                                            Background="Transparent" BorderThickness="0" Padding="0"
                                            HorizontalAlignment="Left" VerticalAlignment="Top" Cursor="Hand"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="PREVIEW" Width="120">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Width="72" Height="72" CornerRadius="6" Background="#F1F5F8">
                                        <Image Source="{Binding Image}" Stretch="Uniform" Margin="5"/>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Binding="{Binding Drawing}" Header="DRAWING" Width="160"/>
                        <DataGridTextColumn Binding="{Binding Rev}" Header="REV" Width="70"/>
                        <DataGridTextColumn Binding="{Binding Description}" Header="DESCRIPTION" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
        </Grid>

        <Grid x:Name="OrdersView" Grid.Column="1" Margin="34,28,34,34" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Orders catalog" Foreground="{StaticResource TextBrush}"
                               FontSize="25" FontWeight="SemiBold"/>
                    <TextBlock Text="Find and review customer order records."
                               Foreground="{StaticResource MutedTextBrush}" FontSize="13" Margin="0,6,0,0"/>
                </StackPanel>
                <Button x:Name="AddCustomer" Grid.Column="1" Style="{StaticResource PrimaryButtonStyle}"
                        Content="＋  Add customer" VerticalAlignment="Top"
                        ToolTip="Customer records will be available after the database is connected."/>
            </Grid>

            <Grid Grid.Row="1" Margin="0,0,0,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="190"/>
                    <ColumnDefinition Width="190"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Height="42" Background="{StaticResource SurfaceBrush}"
                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                        CornerRadius="7" Margin="0,0,12,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="38"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="⌕" Foreground="{StaticResource MutedTextBrush}" FontSize="20"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <TextBox x:Name="SearchOrderTextBox" Grid.Column="1"
                                 Background="Transparent" BorderThickness="0" Padding="0"
                                 VerticalContentAlignment="Center" FontSize="13"/>
                    </Grid>
                </Border>

                <ComboBox x:Name="OrderSearchByMenu" Grid.Column="1"
                          Style="{StaticResource FormComboBoxStyle}" Margin="0,0,12,0"
                          SelectedIndex="0">
                    <ComboBoxItem Content="Search by: Order ID"/>
                    <ComboBoxItem Content="Search by: Customer name"/>
                    <ComboBoxItem Content="Search by: Date"/>
                </ComboBox>

                <ComboBox x:Name="OrderSortByMenu" Grid.Column="2"
                          Style="{StaticResource FormComboBoxStyle}" Margin="0,0,12,0"
                          SelectedIndex="0">
                    <ComboBoxItem Content="Sort: Earliest to latest"/>
                    <ComboBoxItem Content="Sort: Latest to earliest"/>
                </ComboBox>

                <Button x:Name="SearchOrderButton" Grid.Column="3"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Content="Search"/>
            </Grid>

            <Grid Grid.Row="2" Margin="2,0,2,9">
                <TextBlock Text="Orders" Foreground="{StaticResource TextBrush}"
                           FontWeight="SemiBold" FontSize="13"/>
            </Grid>

            <Border Grid.Row="3" Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8">
                <DataGrid x:Name="OrdersDatabase"
                          AutoGenerateColumns="False"
                          Background="Transparent"
                          BorderThickness="0"
                          GridLinesVisibility="Horizontal"
                          HorizontalGridLinesBrush="{StaticResource BorderBrush}"
                          VerticalGridLinesBrush="Transparent"
                          RowBackground="White"
                          AlternatingRowBackground="#FAFCFD"
                          AlternationCount="2"
                          RowHeaderWidth="0"
                          HeadersVisibility="Column"
                          CanUserAddRows="False"
                          CanUserResizeRows="False"
                          IsReadOnly="True"
                          SelectionMode="Single"
                          SelectionUnit="FullRow"
                          FontSize="13">
                    <DataGrid.Resources>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="{StaticResource SurfaceMutedBrush}"/>
                            <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}"/>
                            <Setter Property="FontSize" Value="11"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter Property="Padding" Value="14,11"/>
                            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
                            <Setter Property="BorderThickness" Value="0,0,0,1"/>
                            <Setter Property="HorizontalContentAlignment" Value="Left"/>
                        </Style>
                        <Style TargetType="DataGridCell">
                            <Setter Property="Padding" Value="14,10"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="VerticalContentAlignment" Value="Center"/>
                            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                        </Style>
                        <Style TargetType="DataGridRow">
                            <Setter Property="MinHeight" Value="52"/>
                            <Setter Property="BorderThickness" Value="0"/>
                        </Style>
                    </DataGrid.Resources>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="ORDER ID" Width="180"/>
                        <DataGridTextColumn Header="CUSTOMER NAME" Width="*"/>
                        <DataGridTextColumn Header="ORDER DATE" Width="220"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
        </Grid>
    </Grid>
</Window>
