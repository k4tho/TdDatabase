<Window x:Class="PartsInfo.AddNewPartWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PartsInfo"
        mc:Ignorable="d"
        Title="Add Part" Height="700" Width="760"
        MinHeight="600" MinWidth="680"
        WindowStartupLocation="CenterOwner"
        FontFamily="Segoe UI"
        Background="{StaticResource WindowBackgroundBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1"
                Padding="30,24">
            <StackPanel>
                <TextBlock Text="Add a part" Foreground="{StaticResource TextBrush}"
                           FontSize="24" FontWeight="SemiBold"/>
                <TextBlock Text="Create a new record in the parts catalog."
                           Foreground="{StaticResource MutedTextBrush}" FontSize="13" Margin="0,6,0,0"/>
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="30,24">
                <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="Identification" Style="{StaticResource SectionTitleStyle}"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="18"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="18"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="18"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Grid.Column="0">
                                <TextBlock x:Name="LabelPartNumber" Text="Part number *" Style="{StaticResource FieldLabelStyle}"/>
                                <TextBox x:Name="TextboxPartNumber" Style="{StaticResource FormTextBoxStyle}"/>
                            </StackPanel>
                            <StackPanel Grid.Row="0" Grid.Column="2">
                                <TextBlock x:Name="LabelDrawing" Text="Drawing *" Style="{StaticResource FieldLabelStyle}"/>
                                <TextBox x:Name="TextboxDrawing" Style="{StaticResource FormTextBoxStyle}"/>
                            </StackPanel>
                            <StackPanel Grid.Row="2" Grid.Column="0">
                                <TextBlock x:Name="LabelRev" Text="Revision" Style="{StaticResource FieldLabelStyle}"/>
                                <TextBox x:Name="TextboxRev" Style="{StaticResource FormTextBoxStyle}"/>
                            </StackPanel>
                            <StackPanel Grid.Row="2" Grid.Column="2">
                                <TextBlock x:Name="LabelImage" Text="Part image" Style="{StaticResource FieldLabelStyle}"/>
                                <Button x:Name="ButtonImage" Content="Choose PNG"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        HorizontalContentAlignment="Left"
                                        Click="AddImage_Button_Click"/>
                            </StackPanel>
                            <StackPanel Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="3">
                                <TextBlock x:Name="LabelDescription" Text="Description" Style="{StaticResource FieldLabelStyle}"/>
                                <TextBox x:Name="TextboxDescription" Style="{StaticResource FormTextBoxStyle}"
                                         MinHeight="72" AcceptsReturn="True" TextWrapping="Wrap"
                                         VerticalContentAlignment="Top"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardBorderStyle}">
                    <StackPanel>
                        <TextBlock Text="Purchasing details" Style="{StaticResource SectionTitleStyle}"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="18"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="18"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="18"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="18"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Grid.Column="0">
                                <TextBlock x:Name="LabelMaterial" Text="Material" Style="{StaticResource FieldLabelStyle}"/>
                                <TextBox x:Name="TextboxMaterial" Style="{StaticResource FormTextBoxStyle}"/>
                            </StackPanel>
                            <StackPanel Grid.Row="0" Grid.Column="2">
                                <TextBlock x:Name="LabelSupplier" Text="Supplier" Style="{StaticResource FieldLabelStyle}"/>
                                <TextBox x:Name="TextboxSupplier" Style="{StaticResource FormTextBoxStyle}"/>
                            </StackPanel>
                            <StackPanel Grid.Row="2" Grid.Column="0">
                                <TextBlock x:Name="LabelMaterialCost" Text="Material cost" Style="{StaticResource FieldLabelStyle}"/>
                                <TextBox x:Name="TextboxMaterialCost" Style="{StaticResource FormTextBoxStyle}"/>
                            </StackPanel>
                            <StackPanel Grid.Row="2" Grid.Column="2">
                                <TextBlock x:Name="LabelPriceEach" Text="Price each" Style="{StaticResource FieldLabelStyle}"/>
                                <TextBox x:Name="TextboxPriceEach" Style="{StaticResource FormTextBoxStyle}"/>
                            </StackPanel>
                            <StackPanel Grid.Row="4" Grid.Column="0">
                                <TextBlock x:Name="LabelSource" Text="Source" Style="{StaticResource FieldLabelStyle}"/>
                                <ComboBox x:Name="ComboboxSource" Style="{StaticResource FormComboBoxStyle}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}" VerticalAlignment="Center"/>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="3">
                                <TextBlock x:Name="LabelComment" Text="Comment" Style="{StaticResource FieldLabelStyle}"/>
                                <TextBox x:Name="TextboxComment" Style="{StaticResource FormTextBoxStyle}"
                                         MinHeight="72" AcceptsReturn="True" TextWrapping="Wrap"
                                         VerticalContentAlignment="Top"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2" Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0"
                Padding="30,16">
            <Button x:Name="ButtonAdd" Content="Add part" Width="110"
                    HorizontalAlignment="Right" Style="{StaticResource PrimaryButtonStyle}"
                    Click="Add_Button_Click"/>
        </Border>
    </Grid>
</Window>
